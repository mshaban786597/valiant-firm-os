# Database (Supabase Postgres compatible)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# AI providers (optional — deterministic fallbacks always work)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Webhooks (optional — omit WEBHOOK_SECRET to disable signature enforcement locally)
WEBHOOK_SECRET=""

# Phase 3 automation
# Shared secret for the report-generation cron (GET /api/cron/generate-reports).
# Required for that endpoint; send as `x-cron-secret` header.
CRON_SECRET=""
# Set to "true" to allow workflow webhook_post actions to make real outbound
# HTTP requests. Off by default (actions are simulated/skipped).
ALLOW_OUTBOUND_WEBHOOKS=""
# Per-provider inbound webhook signing secrets (POST /api/webhooks/<provider>).
# Leave blank to accept unverified during setup.
WEBHOOK_SECRET_GSC=""
WEBHOOK_SECRET_GA4=""
WEBHOOK_SECRET_GBP=""
STRIPE_WEBHOOK_SECRET=""
CALENDLY_WEBHOOK_SECRET=""
TYPEFORM_WEBHOOK_SECRET=""

# Email service provider (Resend). Without it, email sends are simulated.
RESEND_API_KEY=""

# Seed credentials (optional overrides)
SEED_ADMIN_EMAIL="founder@valiantfirm.agency"
SEED_ADMIN_PASSWORD="ValiantDemo!2026"
