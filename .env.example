# Database (Supabase Postgres compatible)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Auth.js / NextAuth
NEXTAUTH_SECRET="generate-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# AI providers (optional — deterministic fallbacks always work)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-20250514"

# Webhooks. Fail-closed: inbound webhooks are REJECTED (401) when their
# signing secret is unset. Set this to "true" ONLY in local dev to accept
# unverified webhook posts. Never set it in production.
ALLOW_UNVERIFIED_WEBHOOKS=""
WEBHOOK_SECRET=""

# Phase 3 automation
# Shared secret for the report-generation cron (GET /api/cron/generate-reports).
# Required for that endpoint; send as `x-cron-secret` header.
CRON_SECRET=""
# Set to "true" to allow workflow webhook_post actions to make real outbound
# HTTP requests. Off by default (actions are simulated/skipped).
ALLOW_OUTBOUND_WEBHOOKS=""
# Per-provider inbound webhook signing secrets (POST /api/webhooks/<provider>).
# Leave blank to accept unverified during setup.
WEBHOOK_SECRET_GSC=""
WEBHOOK_SECRET_GA4=""
WEBHOOK_SECRET_GBP=""
STRIPE_WEBHOOK_SECRET=""
CALENDLY_WEBHOOK_SECRET=""
TYPEFORM_WEBHOOK_SECRET=""

# Email service provider (Resend). Without it, email sends are simulated.
RESEND_API_KEY=""

# Seed credentials (optional overrides)
SEED_ADMIN_EMAIL="founder@valiantfirm.agency"
SEED_ADMIN_PASSWORD="ValiantDemo!2026"

# ---- Automation system ----------------------------------------------------
# Alerts: each channel is optional. Unset = that channel is skipped, never faked.
ALERT_EMAIL_TO=""            # where incident/lead/approval emails go (needs RESEND_API_KEY)
ALERT_EMAIL_FROM=""          # e.g. "Valiant OS <alerts@yourdomain.com>"
OUTREACH_EMAIL_FROM=""       # sender for approved outreach emails
SLACK_WEBHOOK_URL=""         # Slack incoming webhook
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
# Free Google API key for page speed checks (the keyless shared quota is usually exhausted).
PAGESPEED_API_KEY=""
# Tool Integration Layer (see /integrations for status + connection tests)
GOOGLE_SERVICE_ACCOUNT_JSON=""
# GA4 needs no property id: every property the service account can read is found automatically.
GTM_ACCOUNT_ID=""
GBP_ACCOUNT_ID=""
GOOGLE_ADS_DEVELOPER_TOKEN=""
GOOGLE_ADS_CUSTOMER_ID=""
GOOGLE_ADS_REFRESH_TOKEN=""
ALSOASKED_API_KEY=""
ANSWERTHEPUBLIC_API_KEY=""
SURFER_API_KEY=""
CLEARSCOPE_API_KEY=""
MARKETMUSE_API_KEY=""
FRASE_API_KEY=""
META_ACCESS_TOKEN=""
META_AD_ACCOUNT_ID=""
LINKEDIN_ACCESS_TOKEN=""
TIKTOK_ACCESS_TOKEN=""
TIKTOK_ADVERTISER_ID=""
MAILCHIMP_API_KEY=""
SHOPIFY_STORE_DOMAIN=""
SHOPIFY_ADMIN_TOKEN=""
AMAZON_SP_REFRESH_TOKEN=""
AMAZON_SP_CLIENT_ID=""
AMAZON_SP_CLIENT_SECRET=""
EBAY_OAUTH_TOKEN=""
ETSY_API_KEY=""
ETSY_ACCESS_TOKEN=""
CALENDLY_API_TOKEN=""
STRIPE_SECRET_KEY=""

# Optional agent runtimes. Unset = the capability is served by the built-in worker.
OPENCLAW_URL=""
HERMES_AGENT_URL=""
ATOMIC_AGENT_URL=""

# ---- Outreach email safety -------------------------------------------------
# Real outreach email is OFF by default. It only sends when ALL of these are set:
#   RESEND_API_KEY, OUTREACH_LIVE_SENDING="true", and the recipient is listed below.
# Demo-scope sends always use the in-app test sender and never leave the app.
OUTREACH_LIVE_SENDING=""
# Comma-separated addresses that may receive real outreach email ("*" = anyone).
# Leave empty to allow nobody. For testing use only your own inbox.
OUTREACH_ALLOWED_RECIPIENTS=""

# ---- Prospecting agent + outreach email content ----------------------------
# Search provider the agent uses to find low-ranking businesses by itself
# (Google Programmable Search JSON API). Empty = the agent cannot search on its
# own; import results with scripts/import-prospects.ts instead.
GOOGLE_CSE_KEY=""
GOOGLE_CSE_CX=""
# Shown in every outreach email.
OUTREACH_SENDER_NAME=""       # defaults to "Valiant Firm"
OUTREACH_BOOKING_URL=""       # link a prospect can use to book a call
OUTREACH_POSTAL_ADDRESS=""    # sender's postal address (required in US commercial email)
# Signing secret of the email provider's webhook (Resend > Webhooks), pointed at
# /api/outreach/events. Needed to record delivered / opened / clicked / bounced.
RESEND_WEBHOOK_SECRET=""
